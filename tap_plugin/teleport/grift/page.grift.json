          "node": {
            "name": "Teleport deployment",
            "slug": "teleport-deployment",
            "description": "One cluster's deployment as a placed picture (teleport-deployment.js): proxies and auth servers inside the cluster box with the certificate authorities, what each runs on to the left, the keys the CAs sign with to the right, the state, audit and recording stores beneath, then each agent with the resources it serves and the targets those front. Scene searches name every edge type they draw.",
            "view": "tap_viz/panels/graph_panel.html",
            "config": {
              "height": "100%",
              "hide_header": true,
              "nav_rules": [
                {
                  "entity_type": "teleport__teleport_cluster",
                  "url_template": "/teleport?cluster={entity_id}"
                }
              ]
            }
          }
        },

            "entity_type": "layout",
            "name": "teleport deployment layout",
            "dimensions": {}
          },
          "node": {
            "name": "teleport deployment layout",
            "description": "Scopes the scene to one cluster (the ?cluster= input, else the only one), nests proxies, auth servers and CAs in the cluster box by their BELONGS_TO_CLUSTER edges, then places compute, keys, storage, agents, resources and targets in bands relative to what they attach to. Names no instance; a node no band accounts for is drawn under the picture and reported.",
            "definition": {
              "js_file": "tap_plugin/teleport/static/teleport/js/projections/teleport-deployment.js",
              "arrangements": []
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0cc73-05a6-7345-afab-4dbed4b8949c",
            "entity_type": "search",
            "name": "teleport — clusters",
            "dimensions": {}
          },
          "node": {
            "name": "teleport — clusters",
            "description": "Every Teleport cluster on the grid, so a cluster with nothing attached is still drawn and a ?cluster= choice can be made. Scene rule: when the deployment picture gains a node or edge type, its search is added here — the graph draws only edges some search returns.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (c:teleport__teleport_cluster)",
                "RETURN c"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0cc73-05a6-7345-afab-4dbf66444ae7",
            "entity_type": "search",
            "name": "teleport — members",
            "dimensions": {}
          },
          "node": {
            "name": "teleport — members",
            "description": "Every deployment-, trust- and resource-plane record with its BELONGS_TO_CLUSTER edge and cluster. Identity- and policy-plane records (users, roles, tokens …) are left to the board below the picture. Scene rule: when the deployment picture gains a node or edge type, its search is added here — the graph draws only edges some search returns.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (n)-[:BELONGS_TO_CLUSTER__teleport]->(c:teleport__teleport_cluster)",
                "WHERE n.dimensions[\"teleport.plane\"] IN [\"deployment\", \"trust\", \"resource\"]",
                "RETURN n, c"
              ]
            }
          }
        },

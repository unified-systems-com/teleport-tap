      "batch_node": {
        "source": "tap_plugin.teleport.grift.page",
        "name": "teleport page v0.1.0",
        "description": "The /teleport operator page (req-teleport-page): the deployment graph panel with its projection, elevation, layout (teleport-deployment.js) and twelve scene searches — one per node set and one per edge type drawn — and seven teleport-board panels (posture, roles, identity, resources, requests, machines, trust). Reusable: nothing here names an instance; the page reads ?cluster=<entity_id> or uses the single cluster on the grid. References no entity outside this file."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a0cc73-05a6-7345-afab-4db9ec5b25b4",
            "entity_type": "page",
            "name": "Teleport",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "Teleport",
            "slug": "/teleport",
            "nav_weight": 120,
            "description": "The operator's front page for one Teleport cluster in a FedRAMP 20x environment: the deployment picture on top (control plane, storage, keys, agents and what they protect), then the cluster's posture, roles and grants, sign-in, protected resources, access requests, machine identities and trust. ?cluster=<entity_id> picks the cluster; with one cluster on the grid it is chosen. Design nodes (dcom=design) render like observed ones and the board marks them.",
            "layout": {
              "full_bleed": true,
              "columns": {
                "col-1": {
                  "width": "1fr",
                  "rows": {
                    "row-1": {
                      "panel-id": "deployment",
                      "height": "75vh"
                    },
                    "row-2": {
                      "panel-id": "posture",
                      "height": "auto"
                    },
                    "row-3": {
                      "panel-id": "roles",
                      "height": "auto"
                    },
                    "row-4": {
                      "panel-id": "identity",
                      "height": "auto"
                    },
                    "row-5": {
                      "panel-id": "resources",
                      "height": "auto"
                    },
                    "row-6": {
                      "panel-id": "requests",
                      "height": "auto"
                    },
                    "row-7": {
                      "panel-id": "machines",
                      "height": "auto"
                    },
                    "row-8": {
                      "panel-id": "trust",
                      "height": "auto"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a0cc73-05a6-7345-afab-4dba620fe9e4",
